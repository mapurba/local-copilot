# -- Copilot auth (required) ---------------------------------------------------
# Set ONE of the following:
#   COPILOT_TOKEN  — a long Copilot JWT copied from VS Code / the Copilot app
#   GITHUB_TOKEN   — a short GitHub OAuth token (ghu_...) — will be exchanged automatically

COPILOT_TOKEN=
GITHUB_TOKEN=     # GitHub PAT or OAuth token — required for all github:* API tools
# GITHUB_TOKEN=

# -- Server settings -----------------------------------------------------------
PORT=3000

# Set to "true" to skip the Allow/Deny approval prompt for all tool calls
ALWAYS_ALLOW_TOOLS=false

# -- SSH connection (optional) -------------------------------------------------
#
# Two ways to provide SSH credentials:
#
#   Option A — Set env vars here (operator-configured, user never sees them)
#   Option B — Leave blank; the LLM will ask the user at runtime and pass
#              the values explicitly to ssh:connect as a config object.
#
# The ssh: tools operate on a REMOTE host only.
# They never conflict with the local custom: tools (readFile, runCommand, etc.)
#
# Priority: explicit config object passed to ssh:connect > env vars below

SSH_HOST=         # remote hostname or IP,  e.g.  192.168.1.100
SSH_PORT=22       # default 22
SSH_USER=         # SSH username,            e.g.  ubuntu
SSH_PASSWORD=     # SSH password

# Key-based auth (preferred over password; leave SSH_PASSWORD blank if using a key)
SSH_KEY_PATH=     # absolute path to private key file, e.g. /home/you/.ssh/id_rsa
SSH_PASSPHRASE=   # passphrase for an encrypted private key (leave blank if none)

# Separate sudo password (defaults to SSH_PASSWORD if left blank)
SSH_SUDO_PASSWORD=

