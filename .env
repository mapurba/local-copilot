# AI Agent Demo — Environment Variables
# Copy this file to .env and fill in your token.

# Option A: Copilot token (long JWT obtained from the GitHub Copilot API)
#   - Usually starts with "ghu_" ... or is a long JWT string
#   - If you have a GitHub Copilot subscription you can get this from the
#     Copilot extension config on disk (apps.json) or via OAuth exchange.
COPILOT_TOKEN=

# Option B: GitHub OAuth token (shorter, ~40 chars)
#   - The server will automatically exchange this for a Copilot token
#   - Generate one at: https://github.com/settings/tokens
#   - Required scopes: copilot (or read:user + gist)
GITHUB_TOKEN=

# Optional: change the port (default: 3000)
# PORT=3000
