{
  "name": "VCD-Agent",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:python": "powershell -ExecutionPolicy Bypass -File scripts/build-python.ps1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "extraResources": [
      {
        "from": "bin/api-win",
        "to": "bin/api-win",
        "filter": ["**/*"]
      }
    ]
    ,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "bin/api-win/**/*"
    ]
  }
}
