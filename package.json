{
  "name": "copilot-chat",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently \"ng serve --port 4100\" \"wait-on http://localhost:4100 && electron .\"",
    "start": "ng serve --port 4100",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.electron.json && ng build",
    "build:watch": "ng build --watch --configuration development",
    "build:electron": "electron-builder",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.local.copilotchat",
    "productName": "Copilot Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "CopilotChat-${version}.exe"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@angular/animations": "19.1.3",
    "@angular/common": "19.1.3",
    "@angular/compiler": "19.1.3",
    "@angular/core": "19.1.3",
    "@angular/elements": "19.1.3",
    "@angular/forms": "19.1.3",
    "@angular/platform-browser": "19.1.3",
    "@angular/platform-browser-dynamic": "19.1.3",
    "@angular/router": "19.1.3",
    "@github/copilot-language-server": "^1.439.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "vscode-languageclient": "^9.0.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "19.1.3",
    "@angular/cli": "19.1.3",
    "@angular/compiler-cli": "19.1.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.11.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.48.0",
    "wait-on": "^9.0.4"
  }
}