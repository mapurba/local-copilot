{
  "name": "vcd-agent",
  "private": true,
  "version": "0.0.8",
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.electron.json && vite build",
    "build:electron": "electron-builder",
    "build:store": "electron-builder --win appx",
    "preview": "vite preview",
    "lint": "eslint .",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.idemo.localcopilot",
    "productName": "vmware Local Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "VCD-Agent-${version}.exe"
    },
    "appx": {
      "identityName": "idemo.app.vmwarellmagent",
      "publisher": "CN=8479939A-507A-4DA6-950F-30B91832207D",
      "publisherDisplayName": "idemo.app",
      "applicationId": "LocalCopilot",
      "displayName": "VMware LLM Agent",
      "backgroundColor": "transparent",
      "languages": ["en-US"],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "artifactName": "LocalCopilot-${version}.msix"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@github/copilot-language-server": "^1.439.0",
    "@langchain/core": "^1.1.30",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/openai": "^1.2.12",
    "@monaco-editor/react": "^4.7.0",
    "@types/ssh2": "^1.15.5",
    "@ux-aspects-universal/react": "^9.7.0",
    "@ux-aspects-universal/themes": "^9.7.0",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.4.2",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.55.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-aria": "^3.48.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.46.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "vscode-languageclient": "^9.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
