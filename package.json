{
  "name": "workflow-agent",
  "private": true,
  "version": "0.0.5",
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently \"ng serve --port 4200\" \"wait-on http://localhost:4200 && electron .\"",
    "start": "ng serve --port 4200",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.electron.json && ng build",
    "build:watch": "ng build --watch --configuration development",
    "build:electron": "electron-builder",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.local.workflowagent",
    "productName": "Workflow Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Workflow-Agent-${version}.exe"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@angular/animations": "19.1.3",
    "@angular/common": "19.1.3",
    "@angular/compiler": "19.1.3",
    "@angular/core": "19.1.3",
    "@angular/elements": "19.1.3",
    "@angular/forms": "19.1.3",
    "@angular/platform-browser": "19.1.3",
    "@angular/platform-browser-dynamic": "19.1.3",
    "@angular/router": "19.1.3",
    "@github/copilot-language-server": "^1.439.0",
    "@iam/workflowbuilder": "^1.0.4-next",
    "@langchain/core": "^1.1.30",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/openai": "^1.2.12",
    "@iam/angular-formio": "^5.3.0-rc.2-next",
    "@iam/formiojs": "^4.14.6-next",
    "ngx-monaco-editor-v2": "19.0.2",
    "fast-xml-parser": "^5.4.2",
    "monaco-editor": "0.52.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "vscode-languageclient": "^9.0.1",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.25.67",
    "zone.js": "^0.15.0",
    "url": "^0.11.0",
    "url-polyfill": "^1.1.12"
  },
  "devDependencies": {
    "@angular/build": "19.1.3",
    "@angular/cli": "19.1.3",
    "@angular/compiler-cli": "19.1.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.11.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.48.0",
    "wait-on": "^9.0.4"
  }
}