{
  "name": "copilot-chat",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"ng serve --port 4100\" \"wait-on http://localhost:4100 && cross-env ELECTRON_START_URL=http://localhost:4100 electron .\"",
    "start": "ng serve --port 4100",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.electron.json && ng build --configuration production",
    "build:watch": "ng build --watch --configuration development",
    "build:electron": "npm run build && electron-builder",
    "lint": "eslint .",
    "convert-prd": "node workflow-agent/js/convert_prd.js"
  },
  "build": {
    "appId": "com.local.copilotchat",
    "productName": "Copilot Chat",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "@angular/animations": "19.1.3",
    "@angular/common": "19.1.3",
    "@angular/core": "19.1.3",
    "@angular/forms": "19.1.3",
    "@angular/platform-browser": "19.1.3",
    "@angular/platform-browser-dynamic": "19.1.3",
    "@angular/router": "19.1.3",
    "@github/copilot-language-server": "^1.439.0",
    "@iam/angular-formio": "^5.3.0-rc.2-next",
    "@iam/formiojs": "^4.14.6-next",
    "@iam/workflowbuilder": "^1.0.4-next",
    "@langchain/core": "^1.1.30",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/openai": "^1.2.12",
    "@microfocus/ias-icons": "1.1.67",
    "fast-xml-parser": "^5.4.2",
    "monaco-editor": "0.52.2",
    "ngx-monaco-editor-v2": "19.0.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "url": "^0.11.0",
    "url-polyfill": "^1.1.12",
    "vscode-languageclient": "^9.0.1",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.25.67",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "19.1.3",
    "@angular/cli": "19.1.3",
    "@angular/compiler-cli": "19.1.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.12.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.48.0",
    "wait-on": "^9.0.4"
  }
}
